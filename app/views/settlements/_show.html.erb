<% @settlements.each do |settlement| %>
  <div class="modal fade" id="showModal_<%= settlement.id %>" tabindex="-1" aria-labelledby="settlementModalLabel_<%= settlement.id %>" aria-hidden="true"
  style="background:rgba(55,55,55,.6); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">

        <div class="modal-header">
          <h4 class="modal-title" id="settlementModalLabel_<%= settlement.id %>">Settlement Details</h4>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body">
          <div class="container mt-4">
            <div class="card shadow-sm p-4">
              <h3 class="mb-3">Settlement ID: <%= settlement.id %></h3>
              <p><strong>Payer:</strong> <%= settlement.payer.first_name.camelize %> <%= settlement.payer.last_name.camelize %></p>
              <p><strong>Payee:</strong> <%= settlement.payee.first_name.camelize %> <%= settlement.payee.last_name.camelize %></p>
              <p><strong>Amount:</strong> ₹<%= '%.2f' % settlement.amount %></p>
              <%# <p><strong>Status:</strong> <%= expense.status.capitalize %></p>
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-danger rounded-pill px-4 shadow-sm" data-bs-dismiss="modal">Close</button>
        </div>

      </div>
    </div>
  </div>
<% end %>
