<div class="container mt-4">
  <h2 class="text-center text-primary fw-bold mb-4">Group Management</h2>

  <div class="d-flex justify-content-center mb-4">
    <%= form_with(url: groups_path, method: :get, local: true, class: "d-flex gap-2 w-50") do %>
      <div class="input-group">
        <span class="input-group-text bg-white border-light rounded-pill px-3"><i class="bi bi-search text-primary"></i></span>
        <%= text_field_tag :search, params[:search], class: "form-control border-light rounded-pill shadow-sm", placeholder: "Search groups..." %>
      </div>
      <%= submit_tag "Search", class: "btn btn-primary rounded-pill px-4 shadow-sm" %>
    <% end %>
  </div>

  <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
    <table class="table table-hover align-middle">
      <thead class="table">
        <tr>
          <th class="text-start">Name</th>
          <th class="text-start">Description</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if @groups.any? %>
          <% @groups.each do |group| %>
            <tr>
              <td class="fw-bold"><%= group.name.camelize %></td>
              <td class="text-muted"><%= group.description %></td>
              <td class="text-end">
                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#showModal_<%= group.id %>">
                  Show
                </button>
                <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#editModal_<%= group.id %>">
                  Edit
                </button>
                <%= link_to "Delete", group, data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-outline-danger btn-sm rounded-pill px-3 shadow-sm" %>
              </td>
            <%= render 'show', group: group %>
            <%= render 'edit', group: group %>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="3" class="text-center text-muted">No groups found.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
