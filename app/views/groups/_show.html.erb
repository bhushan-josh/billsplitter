<% @groups.each do |group| %>
  <div class="modal fade" id="showModal_<%= group.id %>" tabindex="-1" aria-labelledby="groupModalLabel_<%= group.id %>" aria-hidden="true" 
  style="background:rgba(55,55,55,.6); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">

        <div class="modal-header">
          <h4 class="modal-title" id="groupModalLabel_<%= group.id %>">Group Details</h4>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body">
          <div class="container mt-4">
            <div class="card shadow-sm p-4">
              <h3 class="mb-3"><%= group.name.camelize %></h3>
              <p><strong>Description:</strong> <%= group.description %></p>
              <p><strong>Members:</strong></p>
              <ul class="list-group">
                <% group.members.each do |member| %>
                  <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span><%= member.first_name.camelize %> <%= member.last_name.camelize %></span>
                    <span><%= member.role %></span>
                  </li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-danger rounded-pill px-4 shadow-sm" data-bs-dismiss="modal">Close</button>
        </div>

      </div>
    </div>
  </div>
<% end %>
