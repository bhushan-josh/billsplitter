<section class="bg-light py-3 py-md-5 vh-100">
  <div class="container h-100 d-flex justify-content-center align-items-center">
    <div class="row justify-content-center w-100">
      <div class="col-12 col-sm-10 col-md-8 col-lg-7 col-xl-6 col-xxl-5">
        <div class="card border border-light-subtle rounded-3 shadow-sm">
          <div class="card-body p-3 p-md-4 p-xl-5">
            <h2 class="fs-5 fw-bold text-center text-primary mb-4">Edit Profile</h2>

            <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
              <%= render "devise/shared/error_messages", resource: resource %>

              <div class="form-floating mb-3">
                <%= f.email_field :email, class: "form-control", placeholder: "Email", autofocus: true, autocomplete: "email" %>
                <label>Email</label>
              </div>

              <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
                <div class="alert alert-warning text-center">Waiting for confirmation: <%= resource.unconfirmed_email %></div>
              <% end %>

              <div class="form-floating mb-3">
                <%= f.password_field :password, class: "form-control", placeholder: "New Password", autocomplete: "new-password" %>
                <label>New Password (leave blank if unchanged)</label>
              </div>

              <% if @minimum_password_length %>
                <p class="small text-muted"><em>Minimum <%= @minimum_password_length %> characters</em></p>
              <% end %>

              <div class="form-floating mb-3">
                <%= f.password_field :password_confirmation, class: "form-control", placeholder: "Confirm Password", autocomplete: "new-password" %>
                <label>Confirm Password</label>
              </div>

              <div class="form-floating mb-3">
                <%= f.password_field :current_password, class: "form-control", placeholder: "Current Password", autocomplete: "current-password" %>
                <label>Current Password (required to save changes)</label>
              </div>

              <div class="d-grid">
                <%= f.submit "Update", class: "btn btn-primary btn-lg rounded-pill shadow-sm" %>
              </div>
            <% end %><br>

            <div class="text-center mt-3">
              <%= link_to "Back", :back, class: "text-decoration-none text-primary fw-bold" %>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>
</section>
