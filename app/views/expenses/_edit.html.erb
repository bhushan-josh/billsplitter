<div class="modal fade" id="editModal_<%= expense.id %>" tabindex="-1" aria-labelledby="expenseEditLabel_<%= expense.id %>" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">

      <div class="modal-header">
        <h4 class="modal-title" id="expenseEditLabel_<%= expense.id %>">Edit Expense</h4>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <%= form_with model: expense, url: expense_path(expense), method: :patch, class: "needs-validation" do |form| %>
          <div class="row gy-2">
            
            <div class="col-12">
              <div class="form-floating mb-3">
                <%= form.text_field :description, class: "form-control", placeholder: "Description", required: true %>
                <label for="expense_<%= expense.id %>_description">Description</label>
              </div>
            </div>

            <div class="col-12">
              <div class="form-floating mb-3">
                <%= form.number_field :amount, class: "form-control", placeholder: "Amount", step: "0.01", required: true %>
                <label for="expense_<%= expense.id %>_amount">Amount</label>
              </div>
            </div>

            <div class="col-12">
              <div class="form-floating mb-3">
                <%= form.collection_select :paid_by_id, User.all, :id, :email, { prompt: "Select payer" }, class: "form-select" %>
              </div>
            </div>

            <div class="col-12">
              <div class="form-floating mb-3">
                <%= form.collection_select :group_id, Group.all, :id, :name, { prompt: "Select group" }, class: "form-select" %>
              </div>
            </div>

            <div class="col-12">
              <div class="d-grid my-3">
                <%= form.submit "Save Changes", class: "btn btn-primary rounded-pill px-4 py-2 shadow-sm" %>
              </div>
            </div>

            <div class="col-12 text-center">
              <%= link_to 'Cancel', expenses_path, class: "link-primary text-decoration-none" %>
            </div>

          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
