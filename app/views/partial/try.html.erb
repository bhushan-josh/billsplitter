  <% @users.each do |person| %>
  <div class="modal fade" id="editModal_<%= person.id %>" tabindex="-1" aria-labelledby="userModalLabel_<%= person.id %>" aria-hidden="true" 
  style= "background:rgba(55,55,55,.6); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">

        <div class="modal-header">
          <h4 class="modal-title" id="userModalLabel_<%= person.id %>">User Details</h4>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>

<div class="py-3 py-md-5">
  <div class="container h-100 d-flex justify-content-center align-items-center">
    <div class="row justify-content-center w-100">
      <div class="col-12 col-sm-10 col-md-8 col-lg-7 col-xl-6 col-xxl-5">
        <div class="card border border-light-subtle rounded-3 shadow-sm">
          <div class="card-body p-3 p-md-4 p-xl-5">
            <h2 class="fs-5 fw-bold text-center text-secondary mb-4">Edit Profile</h2>

            <%= form_with model: @users, class: "needs-validation" do |form| %>
              <div class="row gy-2 overflow-hidden">
                
                <div class="col-12 col-md-6">
                  <div class="form-floating mb-3">
                    <%= form.text_field :first_name, class: "form-control", placeholder: "First Name", required: true %>
                    <label for="first_name" class="form-label">First Name</label>
                  </div>
                </div>

                <div class="col-12 col-md-6">
                  <div class="form-floating mb-3">
                    <%= form.text_field :last_name, class: "form-control", placeholder: "Last Name", required: true %>
                    <label for="last_name" class="form-label">Last Name</label>
                  </div>
                </div>

                <div class="col-12">
                  <div class="form-floating mb-3">
                    <%= form.telephone_field :phone, class: "form-control", placeholder: "Phone", required: true %>
                    <label for="phone" class="form-label">Phone</label>
                  </div>
                </div>

                <div class="col-12">
                  <div class="form-floating mb-3">
                    <%= form.email_field :email, class: "form-control", placeholder: "name@example.com", required: true %>
                    <label for="email" class="form-label">Email</label>
                  </div>
                </div>

                <div class="col-12">
                  <div class="form-floating mb-3">
                    <%= form.password_field :password, class: "form-control", placeholder: "Password" %>
                    <label for="password" class="form-label">Password</label>
                  </div>
                </div>


                <div class="col-12">
                  <div class="form-floating mb-3">
                    <%= form.text_field :role, class: "form-control", placeholder: "Role" %>
                    <label for="role" class="form-label">Role</label>
                  </div>
                </div>

                <div class="col-12">
                  <div class="d-grid my-3">
                    <%= form.submit "Save Changes", class: "btn btn-primary btn-lg" %>
                  </div>
                </div>

                <div class="col-12 text-center">
                  <%= link_to 'Cancel', users_path, class: "link-primary text-decoration-none" %>
                </div>

              </div>
            <% end %>

          </div>
        </div>
      </div>
    </div>
  </div>
  </div>
      <div class="modal-footer">
          <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
